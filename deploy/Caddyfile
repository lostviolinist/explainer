# HTTPS for the site, with videos and pictures served from the S3 server on
# the same origin (/s3/…), so share links and the player need no CORS.
{$DOMAIN} {
	encode gzip

	# Optional: a shared login for the whole site, so strangers can't spend your API credits.
	# Make the hash with: docker run --rm caddy:2 caddy hash-password --plaintext 'your password'
	# basic_auth {
	# 	friend $2a$14$...
	# }

	handle_path /s3/* {
		reverse_proxy web:9000
	}

	handle {
		reverse_proxy web:3000
	}
}
