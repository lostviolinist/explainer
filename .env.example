# Explainer settings. Copy this file to .env and fill in section 1; everything
# else has a default. `docker compose up` reads .env on its own. git ignores .env,
# so a key written here never leaves your machine.

# === 1. Keys (fill these in) ================================================
# Hedra draws the pictures and clips and records the voice, music and sound
# effects. Create a key in the Hedra dashboard; the format is "key_id:secret".
# The API address (https://api.hedra.com/v3) is built in; section 5 changes it.
HEDRA_API_KEY=

# The language model researches, writes, plans, fills the templates and judges
# the pictures. One key is enough. With ANTHROPIC_API_KEY set, Claude Opus 5.5
# does it; otherwise OpenAI does. Keep both to have Claude write and OpenAI time
# the captions (section 3).
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Exa searches the web for the research stage.
EXA_API_KEY=

# === 2. The language model ===================================================
# Which provider. Blank picks Claude whenever ANTHROPIC_API_KEY is set, OpenAI
# otherwise; write "openai" to use OpenAI while keeping the Anthropic key.
LLM_PROVIDER=
# Which model. Blank means the provider's default: claude-opus-5-5 for Anthropic,
# gpt-6.1-sol for OpenAI. To pin it, write it out: LLM_MODEL=claude-opus-5-5.
# A claude-* name applies to Anthropic and a gpt-* name to OpenAI; the other
# provider keeps its default. LLM_VISION_MODEL is the one that looks at pictures
# and frames; blank means the same model (both defaults see images).
LLM_MODEL=
LLM_VISION_MODEL=
# Claude only: how hard it thinks on every call: low, medium, high, xhigh or max.
# "Opus 5.5 high" is claude-opus-5-5 with LLM_EFFORT=high (the model's own default
# is medium). Higher is slower and costs more per video.
LLM_EFFORT=
# OpenAI only: an OpenAI-compatible endpoint instead of api.openai.com.
OPENAI_BASE_URL=

# === 3. Caption timing =======================================================
# Captions highlight the word being spoken and animations land on words, from a
# transcription of the narration. By default that is OpenAI's whisper-1 with
# OPENAI_API_KEY (about $0.006 per minute of audio); when Claude writes, that is
# the OpenAI key's only job. Without a transcriber the timing is estimated from
# the text: captions still work, less exactly. ALIGNMENT_URL: a WhisperX-class
# endpoint that takes {audio_url, transcript} and returns word timestamps
# (packages/pipeline/src/providers/alignment.ts).
ALIGNMENT_URL=
ALIGNMENT_MODEL=whisper-1

# === 4. What the videos are like ============================================
# Longest video, in seconds (default 180). Deeper research is condensed to fit;
# this is also the main lever on Hedra spend per video.
MAX_VIDEO_SECONDS=180
# A music bed per tone and a small sound-effect kit, generated once through Hedra
# (elevenlabs-music, about $2.40 per tone; elevenlabs-sound-effects, a few cents),
# kept under library/ in the bucket and reused by every video. 0 turns both off.
MUSIC_BED=1
# Experiment: "model" lets the language model write each Illustrated motion
# scene's animation itself, as code on the flat toolkit around the scene's
# picture, rendered in the THREE_URL sandbox and judged on frames. A scene whose
# animation fails the review shows its template instead. Meant for Claude;
# blank means the designed templates, filled in by the model.
ANIMATION_AUTHOR=

# === 5. Hedra details ========================================================
HEDRA_API_BASE=https://api.hedra.com/v3
# Optional: a public URL Hedra calls when a job completes (otherwise we poll).
HEDRA_WEBHOOK_URL=

# === 6. Rendering ============================================================
# "local" renders with @remotion/renderer on the worker; "lambda" uses Remotion
# Lambda (docker compose sets local).
RENDER_TARGET=local
# Speed of the final render. It is bound by Chrome capturing 1080p frames, so the
# levers are cores (Docker Desktop → Resources) and pixels: RENDER_SCALE=0.6667
# renders 720p about twice as fast. Also: tabs painting in parallel (default half
# the cores, fewer when memory is short: a 1080p tab needs about 700 MB and the
# rest of the stack about 2.5 GB), x264 preset (default veryfast) and quality
# (default crf 20).
RENDER_SCALE=
RENDER_CONCURRENCY=
RENDER_X264_PRESET=
RENDER_CRF=
# A render that runs longer than this many seconds is stopped with the reason
# (default 5400, 90 minutes) instead of running all night; "Try again" on the
# page then redoes only the edit. The worker log prints the frame rate as it goes.
RENDER_TIMEOUT_S=
# Optional: an installed Chrome/Chromium instead of Remotion's downloaded headless shell.
REMOTION_BROWSER_EXECUTABLE=
REMOTION_LAMBDA_FUNCTION=
REMOTION_LAMBDA_SERVE_URL=
REMOTION_LAMBDA_REGION=us-east-1

# === 7. Services docker compose runs for you ================================
# docker compose sets every value in this section itself; fill them in only when
# running the app outside it (pnpm dev against your own Postgres, S3 and Inngest).

# Animation sandboxes for model-written code, with no keys and no internet:
# Manim for the 3Blue1Brown style (without it that style is off) and the
# Remotion sandbox for its 3D scenes and for ANIMATION_AUTHOR=model. Illustrated
# videos with the templates need neither.
MANIM_URL=
THREE_URL=

# Storage: Hedra assets are mirrored to an S3 bucket (SeaweedFS in the stack);
# ASSETS_PUBLIC_BASE is the public URL the pipeline reads them back from.
S3_ENDPOINT=
S3_REGION=us-east-1
S3_BUCKET=explainer-assets
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
ASSETS_PUBLIC_BASE=

DATABASE_URL=postgresql://postgres:postgres@localhost:5432/explainer

# Inngest runs the pipeline in the background. INNGEST_DEV points the SDK at the
# dev server (http://localhost:8288 outside Docker); without it events go to
# Inngest Cloud, which needs the two keys below.
INNGEST_DEV=1
INNGEST_BASE_URL=
INNGEST_EVENT_KEY=
INNGEST_SIGNING_KEY=

# The address the site is served at (share links, Hedra callbacks). On a server
# (deploy/README.md) DOMAIN is the hostname Caddy gets a certificate for.
NEXT_PUBLIC_APP_URL=http://localhost:3000
DOMAIN=
