# --- Hedra -------------------------------------------------------------
# Create a key in the Hedra dashboard. Format is "key_id:secret"; the client
# sends it as `Authorization: Key <key_id>:<secret>`.
HEDRA_API_KEY=
HEDRA_API_BASE=https://api.hedra.com/v3
# Optional: public URL Hedra calls when a job completes (otherwise we poll).
HEDRA_WEBHOOK_URL=

# --- LLM (OpenAI) -------------------------------------------------------
# Used for research, script, planner prompts, learner/expert passes, vision QA.
OPENAI_API_KEY=
LLM_MODEL=gpt-6.1-sol
LLM_VISION_MODEL=gpt-6.1-sol

# --- Web search (research stage) ---------------------------------------
# Exa, behind packages/pipeline/src/providers/search.ts
EXA_API_KEY=

# --- Storage (Hedra assets are mirrored here) --------------------------
S3_ENDPOINT=
S3_REGION=us-east-1
S3_BUCKET=explainer-assets
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# Public base URL for mirrored assets (CDN or bucket URL)
ASSETS_PUBLIC_BASE=

# --- Database -----------------------------------------------------------
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/explainer

# --- Inngest ------------------------------------------------------------
# Leave blank for local dev (`npx inngest-cli dev`); set in production.
# INNGEST_DEV=1 makes the SDK send events to the local dev server on :8288.
# Without it, `inngest.send` goes to Inngest Cloud and fails. Remove in production.
INNGEST_DEV=1
INNGEST_EVENT_KEY=
INNGEST_SIGNING_KEY=

# --- Length cap -----------------------------------------------------------
# Longest video, in seconds (default 180). Deeper research is condensed to fit;
# this is also the main lever on Hedra spend per video.
MAX_VIDEO_SECONDS=180

# --- Animation sandboxes ---------------------------------------------------
# Optional. Render AI-written Manim (3Blue1Brown style), flat motion graphics and
# callouts over stills, and three.js (3D) scenes (the last three from THREE_URL).
# The Docker stack runs both and sets these; without them the 3Blue1Brown style
# is off and illustrated videos use stills and Hedra clips only.
MANIM_URL=
THREE_URL=

# --- Music and sound effects ----------------------------------------------
# A music bed per tone and a small sound-effect kit are generated once through
# Hedra (elevenlabs-music, about $2.40 per tone; elevenlabs-sound-effects, a few
# cents in total), stored under library/ in the bucket and reused by every video.
# The bed is played end-aligned, so its composed ending lands on the end card.
# MUSIC_BED=0 turns both off.
MUSIC_BED=1

# --- Rendering ----------------------------------------------------------
# "local" renders with @remotion/renderer on the worker; "lambda" uses Remotion Lambda.
RENDER_TARGET=local
# Optional: use an installed Chrome/Chromium instead of Remotion's downloaded headless shell.
REMOTION_BROWSER_EXECUTABLE=
REMOTION_LAMBDA_FUNCTION=
REMOTION_LAMBDA_SERVE_URL=
REMOTION_LAMBDA_REGION=us-east-1

# --- Word timing (caption highlights, cue words) ------------------------
# By default the narration is transcribed with OpenAI's whisper-1 (word
# timestamps, same key as above; about $0.006 per minute of audio). Optional:
# a WhisperX-class endpoint that accepts {audio_url, transcript} and returns
# word timestamps (packages/pipeline/src/providers/alignment.ts), or another
# OpenAI transcription model that supports word timestamps.
ALIGNMENT_URL=
ALIGNMENT_MODEL=whisper-1

# --- App ----------------------------------------------------------------
NEXT_PUBLIC_APP_URL=http://localhost:3000
